# ORCA Marine Intelligence Platform Configuration

# App Settings
APP_NAME=ORCA Marine Intelligence
APP_ENV=development
DEBUG=True
PORT=8000
HOST=127.0.0.1
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Demo Mode (Forces deterministic verified cache & offline-safe execution)
DEMO_MODE=False

# Database (Leave as sqlite for zero-dependency local dev; or use PostgreSQL + PostGIS)
DATABASE_URL=sqlite+aiosqlite:///./orca_marine.db
# DATABASE_URL=postgresql+asyncpg://orca_user:orca_password@localhost:5432/orca_marine

# LLM Providers (Optional for demo mode - rule-based mock provider works without keys)
LLM_PROVIDER=mock
# LLM_PROVIDER=gemini
# LLM_PROVIDER=openai

GEMINI_API_KEY=
OPENAI_API_KEY=

# External Marine & Weather Endpoints
OPEN_METEO_MARINE_URL=https://marine-api.open-meteo.com/v1/marine
OPEN_METEO_WEATHER_URL=https://api.open-meteo.com/v1/forecast
INCOIS_ERDDAP_URL=https://erddap.incois.gov.in/erddap
